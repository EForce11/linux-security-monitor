# ============================================
# Security Monitor Config
# Copy to ~/.security_monitor.conf and edit.
# ============================================

# --- ntfy.sh ---
NTFY_SERVER="https://ntfy.sh"
NTFY_TOPIC=""                          # Required: your private ntfy topic

# --- Known good sudo users ---
WHITELIST_SUDO_USERS="ubuntu"

# ============================================
# CUSTOM LOG WATCHERS
#
# Add your own application logs below.
# Each entry is 4 values (in order):
#   1. Path to log file
#   2. Pattern to match (grep-compatible)
#   3. Notification title
#   4. Priority: low | default | high | urgent
#
# Example — Vaultwarden:
# EXTRA_LOG_FILES+=(
#     "/home/ubuntu/vaultwarden/vw-data/vaultwarden.log"
#     "Invalid admin token"
#     "⚠️ Vaultwarden admin panel probe"
#     "high"
# )
#
# Example — Nginx:
# EXTRA_LOG_FILES+=(
#     "/var/log/nginx/error.log"
#     "limiting requests"
#     "⚠️ Nginx rate limit hit"
#     "default"
# )
#
# You can add as many blocks as needed.
# ============================================

EXTRA_LOG_FILES=()

# EXTRA_LOG_FILES+=(
#     "/path/to/your/app.log"
#     "your error pattern"
#     "Your alert title"
#     "high"
# )
